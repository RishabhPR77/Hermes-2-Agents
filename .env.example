# .env.example — variable NAMES only. Nothing here is a real value.
#
# Add the actual values yourself, directly into the Hermes profile .env:
#   C:\Users\risha\AppData\Local\hermes\.env
# Never paste values into chat. Never commit real secrets to this repo.
#
# These names are read by the cron scripts, which get them through
# `terminal.env_passthrough` in the HERMES config
# (C:\Users\risha\AppData\Local\hermes\config.yaml) — NOT the project's
# config.yaml. The values themselves live in the Hermes profile .env above.
# The passthrough allowlist is approved config edit B; see README "Scripts".

# --- M91 Platform API (Settings -> API keys in the M91 app) ---
# Key used by m91_review.py to invite recipients, raise and read decision on
# review alerts, and send LOW-severity system notices.
M91_API_KEY=

# Reviewer phones, country code without '+', e.g. 919876543210.
# The primary gets every review alert; the backup only after the deadline
# passes with no decision.
M91_REVIEWER_PHONE=
M91_BACKUP_REVIEWER_PHONE=

# --- viaSocket webhook flows (one flow per Docstar action) ---
# docstar_publish.py posts to PUBLISH_WEBHOOK (flow -> Docstar "Create Page"
# under the configured parent) and reads the created page back from the flow's
# response. docstar_list.py posts to LIST_WEBHOOK (flow -> Docstar
# "List All Pages"/"Find Documents").
VIASOCKET_PUBLISH_WEBHOOK=
VIASOCKET_LIST_WEBHOOK=
# Shared secret checked by BOTH viaSocket flows (header X-ViaSocket-Secret).
# A request without the right secret is ignored by the flows.
VIASOCKET_SHARED_SECRET=

# --- Web search (added via `hermes tools`, NOT this file) ---
# TAVILY_API_KEY=